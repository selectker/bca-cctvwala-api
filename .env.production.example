# ============================================================================
# BCAcctvWala API - production .env for Docker on EC2
#   cp .env.production.example .env && chmod 600 .env
# Rules: one KEY=value per line, NO inline "# comments" after a value, no quotes.
# Already running a version? Copy its old .env and only ADD what is missing here:
# keep the SAME JWT_SECRET (a new one signs everybody out) and the SAME BACKUP_ENCRYPTION_KEY.
# ============================================================================

# ---- Server ----------------------------------------------------------------
PORT=4000
API_WORKERS=2
STORE_STATE_CODE=29
APP_TIMEZONE=Asia/Kolkata

# ---- Database (RDS PostgreSQL) -----------------------------------------------
# DB_HOST must be the RDS endpoint NAME (not an IP), the TLS certificate is checked against it.
# Use a DB password made of letters and digits only: alembic builds a URL from it, and characters like @ : / # break it.
# The RDS security group must allow port 5432 from this EC2's security group.
DB_HOST=your-db.xxxxxxxxxxxx.ap-southeast-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=gst_billing
DB_USER=postgres
DB_PASSWORD=change-me-letters-and-digits-only
DB_SSL=true
# This file is baked into the image by the Dockerfile. Do not change the path.
DB_SSL_CA_FILE=/etc/ssl/certs/rds-global-bundle.pem

# pg_dump major version used in the image (same as, or newer than, your RDS major version). Build-time only (read by deploy.sh).
PG_MAJOR=17

# ---- Secrets -----------------------------------------------------------------
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# One-time secret for the first-run screens (bootstrap-admin / bootstrap-owner). Leave EMPTY once both accounts exist.
SETUP_TOKEN=
JWT_EXPIRES_MINUTES=43200

# ---- Cloudflare R2 (REQUIRED: the API will not start without these) ---------------
# Dashboard > R2 > Manage R2 API Tokens > Create API token > Object Read & Write, limited to your bucket(s).
# Account ID is on the R2 overview page. Keep every bucket PRIVATE (no custom domain, no r2.dev URL).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Ticket photos, shop logo, signature (prefixes service_tickets/ and store/)
R2_BUCKET=bcacctvwala-files
# Backups + pre-restore snapshots (prefixes backups/ and snapshots/). A second bucket is recommended.
# If you use one, the same token must have access to it too. Leave empty to use R2_BUCKET.
R2_BACKUP_BUCKET=bcacctvwala-backups
KEEP_CLOUD_BACKUPS=30
KEEP_SNAPSHOTS=5

# ---- Backup encryption (OPTIONAL) ----------------------------------------------
# Empty = plain pg_dump files. Set a 32+ character key to encrypt backups with AES-256-GCM.
# KEEP A COPY OF THE KEY OUTSIDE THE SERVER (password manager): without it an encrypted backup cannot be restored.
# Once you set it, never change it without the rotation format NEW_KEY,OLD_KEY.
BACKUP_ENCRYPTION_KEY=
MAX_RESTORE_MB=500
BACKUP_TIMEOUT_SECONDS=3600
# Automatic daily backup into R2, taken by the API itself (no cron job). HH:MM in APP_TIMEZONE; 00:00 = midnight IST.
BACKUP_SCHEDULE_ENABLED=true
BACKUP_SCHEDULE_TIME=00:00

# ---- Reverse proxy / client IP --------------------------------------------------
# nginx runs on the EC2 host and reaches the container from the Docker network gateway, so trust that subnet
# (deploy/deploy.sh creates the 'bcnet' Docker network with this fixed subnet). Do NOT set this to 0.0.0.0/0.
TRUSTED_PROXIES=172.28.0.0/24
# nginx sends the real address in X-Real-IP (see deploy/nginx-bcacctvwala.conf)
CLIENT_IP_HEADER=X-Real-IP
# Turn on (31536000) only once HTTPS works and you are sure you will not go back to plain HTTP.
HSTS_MAX_AGE=0

# ---- Features / hardening -------------------------------------------------------
# /api/... (without v1) is only for Android builds 1.25.x and older.
LEGACY_API_ENABLED=false
# Keep false on the public server.
ENABLE_DOCS=false
# Only if a web client is used; the Android app does not need it. Example: https://app.example.com
CORS_ALLOWED_ORIGINS=

# ---- Brute-force protection (defaults shown) --------------------------------------
LOGIN_RATE_LIMIT=10/minute
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_ACCOUNT_FAILURE_CEILING=30
LOGIN_PIN_DAILY_FAILURE_CEILING=100
LOGIN_KNOWN_IP_DAYS=30

# ---- Upload limits ------------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_LOGO_MB=2
MAX_SIGNATURE_MB=1

# true = a technician can't mark a ticket attended without the customer's signature / acknowledgement
# or a written reason there is none. Off by default (an app that doesn't send a sign-off keeps working).
REQUIRE_CUSTOMER_SIGNOFF=false
MAX_PROFILE_IMAGE_MB=2
MAX_BODY_KB=2048
