PORT=4000

DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=5432
DB_NAME=gst_billing
DB_USER=postgres
DB_PASSWORD=change-me
# DB_SSL=true = TLS with full certificate + host name verification ("verify-full"). It REQUIRES the RDS CA bundle:
#   curl -o /etc/ssl/certs/rds-global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# and DB_HOST must be the RDS endpoint name (the certificate is issued for it, an IP address or alias won't match).
# DB_SSL=false (no encryption at all) is for a local development database only.
DB_SSL=true
DB_SSL_CA_FILE=/etc/ssl/certs/rds-global-bundle.pem

# At least 32 random characters (the API refuses to start with less):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# How long a sign-in lasts (default 30 days). Every sign-in is a server-side session that logout / sign-out-everywhere /
# password or PIN change / deactivation end immediately, so you can shorten this without losing control of old tokens.
# JWT_EXPIRES_MINUTES=43200

# One-time secret for POST /auth/bootstrap-admin and /auth/bootstrap-owner (header X-Setup-Token).
# Needed only until both first accounts exist; leave empty afterwards to keep setup disabled.
SETUP_TOKEN=

# Largest ordinary JSON request body in KB (photo uploads and restores have their own limits).
# MAX_BODY_KB=2048
# Largest backup file (MB) that can be uploaded to /api/v1/admin/restore.
# MAX_RESTORE_MB=500
# MAX_LOGO_MB=2
# MAX_SIGNATURE_MB=1

# true = a technician can't mark a ticket attended without the customer's signature / acknowledgement
# or a written reason there is none. Off by default (an app that doesn't send a sign-off keeps working).
# REQUIRE_CUSTOMER_SIGNOFF=false

# Interactive API docs (/docs, /redoc, /openapi.json) are OFF unless you set this; leave it off on a public server.
# ENABLE_DOCS=false

# The API is at /api/v1. The old /api/... paths are OFF by default (false). Set true only while an Android build
# 1.25.x or older (which calls /api/...) is still in use.
LEGACY_API_ENABLED=false

# ---- Who the client is (rate limits, lock-outs and the audit log use the client IP).
# Proxy addresses (IPs or CIDR blocks, comma-separated) whose X-Forwarded-For / CLIENT_IP_HEADER is believed.
# Default = nginx on this same machine. A proxy on another host (load balancer, CloudFront...) must be listed here.
# TRUSTED_PROXIES=127.0.0.1,::1
# Optional single-address header your proxy sets itself, e.g. CF-Connecting-IP (Cloudflare) or X-Real-IP (nginx).
# CLIENT_IP_HEADER=
# The uvicorn --workers value. Per-IP request limits are counted per worker, so each one gets 1/N of the limit.
# Start uvicorn with --no-proxy-headers (this API reads the proxy headers itself).
API_WORKERS=2

# Strict-Transport-Security max-age in seconds (0 = off). Set 31536000 only once the API is served over HTTPS alone.
# HSTS_MAX_AGE=0

STORE_STATE_CODE=29
APP_TIMEZONE=Asia/Kolkata
# Automatic backup into R2 every day (no cron needed). Time is HH:MM in APP_TIMEZONE; 00:00 = midnight IST.
# A failed run is retried BACKUP_SCHEDULE_RETRIES more times, BACKUP_SCHEDULE_RETRY_MINUTES apart.
BACKUP_SCHEDULE_ENABLED=true
BACKUP_SCHEDULE_TIME=00:00
# BACKUP_SCHEDULE_RETRIES=3
# BACKUP_SCHEDULE_RETRY_MINUTES=10
KEEP_SNAPSHOTS=5

# Brute-force protection (all optional; these are the defaults)
LOGIN_RATE_LIMIT=10/minute      # per client IP, shared by login, login-pin, change-pin, change-password, bootstrap
LOGIN_MAX_FAILURES=5            # wrong credentials in a row, from one client IP, before that IP is locked out of that account
LOGIN_LOCKOUT_MINUTES=15        # how long the lock lasts (the right password / PIN is refused meanwhile)
LOGIN_ACCOUNT_FAILURE_CEILING=30  # failures from ALL addresses together before addresses new to the account are refused
LOGIN_PIN_DAILY_FAILURE_CEILING=100  # staff / technician PIN accounts: failures per 24 h from ALL addresses before new addresses are refused (0 = off)
LOGIN_KNOWN_IP_DAYS=30          # an address that signed in successfully within this many days is "known" to the account

# ---- Cloudflare R2 (REQUIRED): ticket photos, backups and safety snapshots live here, never on the server disk.
# R2 dashboard > R2 > Manage API tokens > Create API token (Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional separate bucket for backups (default: same bucket). Keep all buckets PRIVATE: no custom domain, no r2.dev.
R2_BACKUP_BUCKET=
KEEP_CLOUD_BACKUPS=30

# Backup / restore use pg_dump and pg_restore: install the PostgreSQL client tools on this server (same major version
# as the database, or newer), e.g. `sudo apt install postgresql-client-16`. Set the paths if several versions exist.
# PG_DUMP_PATH=pg_dump
# PG_RESTORE_PATH=pg_restore
# A backup or restore running longer than this many seconds is stopped (a restore then changes nothing).
# BACKUP_TIMEOUT_SECONDS=3600

# OPTIONAL. Leave empty for plain pg_dump backups (restorable on any server). Set a key (32+ characters) to encrypt
# every backup, R2 copy and safety snapshot with AES-256-GCM; generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# KEEP A COPY OUTSIDE THE SERVER: without it an encrypted backup cannot be restored. Rotate with "<new>,<old>".
BACKUP_ENCRYPTION_KEY=

# Browser origins allowed to call the API (comma-separated). Leave empty for the Android app alone.
# CORS_ALLOWED_ORIGINS=https://app.example.com
